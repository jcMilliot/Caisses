{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caisses",
  "version": "0.4.0",
  "identifier": "com.xan.caisses",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Caisses",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jcMilliot/Caisses/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzN0U2MjU4MzNDNjJGRjgKUldUNEw4WXpXR0orWXo1YlhDRU5BUDhsOTdrTmg5djZVSXV4VTNFRzRwZ1lPbEZDSjdIWml4SHgK"
    }
  }
}
